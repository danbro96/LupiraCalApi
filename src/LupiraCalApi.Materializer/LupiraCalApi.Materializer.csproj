<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Flow the `///` summaries into the OpenAPI document (host AND Core — the DTOs live in Core). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The materializer host (lupira-cal-materializer): runs the Solo async daemon that keeps
         cal.scheduled_fire in step with item events, plus the nightly horizon sweep. Exactly one replica —
         DaemonMode.Solo claims exclusive ownership. Separate from the dispatcher, which scales on
         SKIP LOCKED claims and depends on assistant-api. -->
    <ProjectReference Include="..\LupiraCalApi.Core\LupiraCalApi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lupira.Hosting.Observability" Version="0.1.1" />
  </ItemGroup>

</Project>
