<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Flow the `///` summaries into the OpenAPI document (host AND Core — the DTOs live in Core). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LupiraCalApi.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bounded context + data: Domain (event-sourced aggregates + events + projections),
         Application (services + OpResult), Dtos, Mappers, Serialization (canonical ICS), Auth/AccessResolver.
         Marten is the event store + document store on Postgres. No ASP.NET dependency — that lives in the host. -->
    <PackageReference Include="Marten" Version="9.40.0" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="NodaTime" Version="3.3.4" />
  </ItemGroup>

</Project>
