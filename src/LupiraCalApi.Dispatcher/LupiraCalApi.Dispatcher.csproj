<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Flow the `///` summaries into the OpenAPI document (host AND Core — the DTOs live in Core). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The dispatcher host (lupira-cal-dispatcher): claims due cal.scheduled_fire rows and pushes them to
         assistant-api POST /fires. Ships as its own image; the API host stays free of outbound calls. -->
    <ProjectReference Include="..\LupiraCalApi.Core\LupiraCalApi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lupira.Clients.ServiceTokens" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.Observability" Version="0.1.1" />
  </ItemGroup>

</Project>
