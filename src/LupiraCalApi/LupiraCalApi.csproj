<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Flow the `///` summaries into the OpenAPI document (host AND Core — the DTOs live in Core). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Build-time OpenAPI document (openapi/LupiraCalApi.json) — consumed by LupiraCal's Orval codegen.
    Doc-gen boots the app and CalApi's startup eagerly creates the cal.scheduled_fire table (needs dev
    Postgres), so generation runs on local builds only and is skipped in CI. This is the one emitter
    that can't run doc-gen without infra; all others use the always-on canonical block.
  -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LupiraCalApi.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bounded context (Domain + Application + Data). The host is a thin transport/composition
         layer over it; the project boundary keeps ASP.NET out of the core. Npgsql / Ical.Net flow in
         transitively from Core. -->
    <ProjectReference Include="..\LupiraCalApi.Core\LupiraCalApi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Lupira.Auth.Jwt" Version="0.1.0" />
    <PackageReference Include="Lupira.Clients.ServiceTokens" Version="0.1.0" />
    <PackageReference Include="Lupira.Depz" Version="0.1.1" />
    <PackageReference Include="Lupira.Hosting.Defaults" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.Health" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.LanEdge" Version="1.0.0" />
    <PackageReference Include="Lupira.Hosting.Observability" Version="0.1.1" />
    <PackageReference Include="Lupira.Hosting.OpenApi" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.Problems" Version="0.1.0" />
    <PackageReference Include="Lupira.Identity.Marten.AspNetCore" Version="0.1.0" />
    <PackageReference Include="Lupira.Mcp" Version="0.1.0" />
  </ItemGroup>

</Project>
